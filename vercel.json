{
  "crons": [
    { "path": "/api/cron/daily-learning", "schedule": "0 4 * * *" }
  ],
  "functions": {
    "api/cron/daily-learning.js": { "maxDuration": 120 },
    "api/history.js": {
      "maxDuration": 120
    },
    "api/backtest.js": {
      "maxDuration": 30
    },
    "api/google-drive-backup.js": {
      "maxDuration": 30
    },
    "api/result-image-ocr.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
